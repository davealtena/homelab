# 1Password secret references for `op run --env-file=.env.op -- tofu ...`.
# These are *references*, not secrets; op resolves them at runtime.
# Item: vault "Homelab", item "hetzner" (create it once; see README).
HCLOUD_TOKEN=op://Homelab/hetzner/api_token
TF_VAR_s3_admin_access_key=op://Homelab/hetzner/s3_admin_access_key
TF_VAR_s3_admin_secret_key=op://Homelab/hetzner/s3_admin_secret_key
# Phase 2 (remote state in the tofu-state bucket); same admin credential.
AWS_ACCESS_KEY_ID=op://Homelab/hetzner/s3_admin_access_key
AWS_SECRET_ACCESS_KEY=op://Homelab/hetzner/s3_admin_secret_key
